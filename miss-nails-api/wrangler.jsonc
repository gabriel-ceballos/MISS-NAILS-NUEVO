
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "miss-nails-app-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,

  "durable_objects": {
    "bindings": [
      {
        "name": "OAUTH_STATE_STORE",
        "class_name": "OAuthStateStore"
      }
    ]
  },

  "exports": {
    "OAuthStateStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "secrets": {
    "required": [
      "GOOGLE_CLIENT_SECRET",
      "MICROSOFT_CLIENT_SECRET",
      "MISS_NAILS_SERVICE_KEY"
    ]
  },

  "observability": {
    "logs": {
      "enabled": true
    }
  },

  "vars": {
    "WORKER_ORIGIN": "https://api.missnails.app",
    "APP_ORIGIN": "https://miss-nails-nuevo.pages.dev",
    "APP_PATH": "/",
    "APP_ORIGINS": "https://missnails.app,https://www.missnails.app,https://miss-nails-nuevo.pages.dev,https://localhost,capacitor://localhost,http://localhost",
    "APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbzXAhVTNxhrvJNvWGumx3hAKG47soHEZ_PFIha2wgMZyLNknE90t0ttfm32cRKKV8TU/exec",
    "GOOGLE_CLIENT_ID": "375980187783-shvrkd8d0nkeaem7tju07co7bponc9ev.apps.googleusercontent.com",
    "MICROSOFT_CLIENT_ID": "0ad43298-3dcc-4622-9b75-f58c73dd695f",
    "MICROSOFT_ALLOWED_TENANTS": "221ce760-a873-4e2c-a9b1-b7fc98b2a627,9188040d-6c67-4c5b-b112-36a304b66dad"
  }
}
